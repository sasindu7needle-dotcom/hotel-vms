APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost
VMS_EVENT_NAME="Traction Guest"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# Store visitor documents outside the deployed release. Use an absolute,
# persistent server directory (or mounted volume) that the web/PHP user can write.
VISITOR_MEDIA_DISK=visitor-media
VISITOR_MEDIA_ROOT=/var/www/visitor-media
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD_HASH=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# SMS gateway for scheduled report summaries. The endpoint must accept a JSON
# POST body with the configured recipient, message and sender field names.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=
SMS_RECIPIENT_FIELD=to
SMS_MESSAGE_FIELD=message
SMS_SENDER_FIELD=from

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=storage/app/google-credentials.json
GOOGLE_VISION_CA_BUNDLE=
GOOGLE_TRANSLATE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CA_BUNDLE=
GEMINI_ALLOW_TESSERACT_FALLBACK=false
GEMINI_NIC_NAME_REVIEW=true

# DirectPay v3 Sandbox. The Merchant Secret stays server-side and is used for
# HMAC-SHA256 checkout and callback signatures.
DIRECTPAY_ENV=sandbox
DIRECTPAY_MERCHANT_ID=
DIRECTPAY_API_KEY=
DIRECTPAY_MERCHANT_SECRET=
DIRECTPAY_CURRENCY=LKR
